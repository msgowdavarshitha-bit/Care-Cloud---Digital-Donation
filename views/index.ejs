<% title = 'CareCloud – Digital Charity Management System' %>

<!-- Hero Section -->
<div class="hero">
    <div class="container">
        <h1>Welcome to CareCloud – Digital Charity Management System</h1>
        <p>Empowering a Brighter Tomorrow, One Donation at a Time.</p>
        <% if(user) { %>
            <a href="/donate" class="btn"><i class="fas fa-hand-holding-heart"></i> Donate Now</a>
        <% } else { %>
            <a href="/signup" class="btn"><i class="fas fa-user-plus"></i> Sign Up to Donate</a>
        <% } %>
    </div>
</div>

<!-- Stats Section -->
<section class="stats-section" style="padding: 3rem 0; background: rgba(255,255,255,0.9); margin: 2rem 0;">
    <div class="container">
        <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; text-align: center;">
            <div class="stat-card" style="padding: 2rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
                <div class="stat-number" style="font-size: 2.5rem; font-weight: bold; margin-bottom: 0.5rem;">10,000+</div>
                <div class="stat-label" style="font-size: 1.1rem;">Donations Made</div>
            </div>
            <div class="stat-card" style="padding: 2rem; background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%); color: white; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
                <div class="stat-number" style="font-size: 2.5rem; font-weight: bold; margin-bottom: 0.5rem;">50+</div>
                <div class="stat-label" style="font-size: 1.1rem;">Communities Helped</div>
            </div>
            <div class="stat-card" style="padding: 2rem; background: linear-gradient(135deg, #e74c3c 0%, #e67e22 100%); color: white; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
                <div class="stat-number" style="font-size: 2.5rem; font-weight: bold; margin-bottom: 0.5rem;">5,000+</div>
                <div class="stat-label" style="font-size: 1.1rem;">People Impacted</div>
            </div>
            <div class="stat-card" style="padding: 2rem; background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%); color: white; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
                <div class="stat-number" style="font-size: 2.5rem; font-weight: bold; margin-bottom: 0.5rem;">100+</div>
                <div class="stat-label" style="font-size: 1.1rem;">Volunteers</div>
            </div>
        </div>
    </div>
</section>

<!-- Main Content -->
<div class="container">
    <div class="page-content">
        <h2 class="page-title">About Our Mission</h2>
        <div class="card">
            <p>CareCloud – Digital Charity Management System is dedicated to connecting generous donors with communities in need. We believe that small acts of kindness can create big changes in the world. Through our platform, you can easily donate money or items to support various causes and make a difference in someone's life.</p>
            
            <p>Our mission is to make the donation process simple, secure, and impactful. We ensure that every donation reaches the right hands and creates positive change in communities around the world.</p>
        </div>
        
        <div class="card">
            <h3>Why Donate With Us?</h3>
            <ul>
                <li><i class="fas fa-check-circle" style="color: #27ae60; margin-right: 0.5rem;"></i> Secure and transparent donation process</li>
                <li><i class="fas fa-check-circle" style="color: #27ae60; margin-right: 0.5rem;"></i> Direct impact on communities in need</li>
                <li><i class="fas fa-check-circle" style="color: #27ae60; margin-right: 0.5rem;"></i> Tax-deductible donations</li>
                <li><i class="fas fa-check-circle" style="color: #27ae60; margin-right: 0.5rem;"></i> Real-time updates on donation impact</li>
                <li><i class="fas fa-check-circle" style="color: #27ae60; margin-right: 0.5rem;"></i> Multiple donation options to suit your preferences</li>
            </ul>
        </div>
        
        <!-- Testimonials Section -->
        <div class="card">
            <h3>What People Say</h3>
            <div class="testimonials" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 1.5rem;">
                <div class="testimonial" style="padding: 1.5rem; background: #f8f9fa; border-radius: 10px; border-left: 4px solid #667eea;">
                    <p style="font-style: italic; margin-bottom: 1rem;">"This platform made it so easy to donate books to children in need. The impact was immediate and visible!"</p>
                    <strong>- Sarah Johnson</strong>
                </div>
                <div class="testimonial" style="padding: 1.5rem; background: #f8f9fa; border-radius: 10px; border-left: 4px solid #27ae60;">
                    <p style="font-style: italic; margin-bottom: 1rem;">"I love knowing my donations are going directly to those who need them. The transparency is amazing."</p>
                    <strong>- Michael Chen</strong>
                </div>
            </div>
        </div>
        
        <!-- Contact Information Section -->
        <div class="card">
            <h3><i class="fas fa-address-book" style="color: #3498db; margin-right: 0.5rem;"></i> Contact Information</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-top: 1.5rem;">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <i class="fas fa-map-marker-alt" style="color: #e74c3c; font-size: 1.5rem;"></i>
                    <div>
                        <h4>Our Address</h4>
                        <p style="margin: 0; color: #666;">Vijayanagar Park Road, Hassan</p>
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <i class="fas fa-phone" style="color: #27ae60; font-size: 1.5rem;"></i>
                    <div>
                        <h4>Call Us</h4>
                        <p style="margin: 0; color: #666;">+91 9823783450</p>
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <i class="fas fa-envelope" style="color: #3498db; font-size: 1.5rem;"></i>
                    <div>
                        <h4>Email Us</h4>
                        <p style="margin: 0; color: #666;">carecloud505@gmail.com</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>