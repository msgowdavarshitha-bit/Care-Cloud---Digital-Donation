<% title = 'Suggest - CareCloud – Digital Charity Management System' %>

<!-- Suggestion Form -->
<div class="container">
    <div class="form-container">
        <h2 class="page-title">Submit Your Suggestion</h2>
        
        <% if (error) { %>
            <div class="error-message"><%= error %></div>
        <% } %>
        
        <% if (success) { %>
            <div class="success-message"><%= success %></div>
        <% } %>
        
        <form method="POST" action="/suggest">
            <div class="form-group">
                <label for="name"><i class="fas fa-user" style="color: #667eea; margin-right: 0.5rem;"></i> Name *</label>
                <input type="text" id="name" name="name" value="<%= userName %>" required>
            </div>
            
            <div class="form-group">
                <label for="email"><i class="fas fa-envelope" style="color: #27ae60; margin-right: 0.5rem;"></i> Email *</label>
                <input type="email" id="email" name="email" value="<%= userEmail %>" required>
            </div>
            
            <div class="form-group">
                <label for="suggestion"><i class="fas fa-lightbulb" style="color: #f39c12; margin-right: 0.5rem;"></i> Suggestion *</label>
                <textarea id="suggestion" name="suggestion" rows="5" required placeholder="Share your ideas for improving our charity platform..."></textarea>
            </div>
            
            <button type="submit" class="btn"><i class="fas fa-paper-plane"></i> Submit Suggestion</button>
        </form>
    </div>
    
    <!-- Suggestions Section -->
    <div class="card" style="margin-top: 2rem;">
        <h3><i class="fas fa-comments" style="color: #3498db; margin-right: 0.5rem;"></i> Why Your Suggestions Matter</h3>
        <p>Your feedback helps us continuously improve our platform and better serve our community. We value your input and use it to enhance the donation experience for everyone.</p>
        <ul>
            <li>Help us identify areas for improvement</li>
            <li>Share innovative ideas for new features</li>
            <li>Provide feedback on your user experience</li>
            <li>Suggest ways to make donations easier and more impactful</li>
        </ul>
    </div>
</div>