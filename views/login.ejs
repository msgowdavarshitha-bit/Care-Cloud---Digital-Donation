<% title = 'Login - CareCloud – Digital Charity Management System' %>

<!-- Login Form -->
<div class="container">
    <div class="form-container">
        <h2 class="page-title">Login to Your Account</h2>
        
        <% if (error) { %>
            <div class="error-message"><%= error %></div>
        <% } %>
        
        <form method="POST" action="/login">
            <div class="form-group">
                <label for="email"><i class="fas fa-envelope" style="color: #667eea; margin-right: 0.5rem;"></i> Email *</label>
                <input type="email" id="email" name="email" required placeholder="Enter your email address...">
            </div>
            
            <div class="form-group">
                <label for="password"><i class="fas fa-lock" style="color: #27ae60; margin-right: 0.5rem;"></i> Password *</label>
                <input type="password" id="password" name="password" required placeholder="Enter your password...">
            </div>
            
            <button type="submit" class="btn"><i class="fas fa-sign-in-alt"></i> Login</button>
        </form>
        
        <p style="margin-top: 1rem; text-align: center;">
            Don't have an account? <a href="/signup" class="btn btn-secondary" style="display: inline-block; margin-left: 0.5rem; background: linear-gradient(135deg, #95a5a6 0%, #bdc3c7 100%);"><i class="fas fa-user-plus"></i> Sign up here</a>
        </p>
    </div>
    
    <!-- Welcome Section -->
    <div class="card" style="margin-top: 2rem;">
        <h3><i class="fas fa-hand-holding-heart" style="color: #e74c3c; margin-right: 0.5rem;"></i> Welcome Back!</h3>
        <p>Thank you for continuing to support our charitable mission. Your contributions help make a real difference in the lives of those in need.</p>
        <p>By logging in, you can:</p>
        <ul>
            <li>Track your donation history</li>
            <li>Manage your donation preferences</li>
            <li>View your impact statistics</li>
            <li>Receive updates on how your donations are helping</li>
        </ul>
    </div>
</div>